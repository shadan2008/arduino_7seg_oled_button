void setup() {
  pinMode(2,OUTPUT); pinMode(3,OUTPUT); pinMode(4,OUTPUT); pinMode(5,OUTPUT);
  pinMode(6,OUTPUT); pinMode(7,OUTPUT); pinMode(8,OUTPUT);
  pinMode(10,INPUT_PULLUP); // FIXED - must be PULLUP

  // show 0 at start
  digitalWrite(2,LOW); digitalWrite(3,LOW); digitalWrite(4,LOW); digitalWrite(5,LOW); digitalWrite(6,LOW); digitalWrite(7,LOW); digitalWrite(8,HIGH);
  u8g.firstPage();
  do { u8g.drawBitmapP(0,0,16,64,OLED_1); } while(u8g.nextPage());
}

int count = 0;

void loop() {
  if(digitalRead(10) == LOW) {
    delay(200);
    count++;
    if(count > 9) count = 1; // only 1 and 2 for now since you have 2 images

    if(count == 1) {
      // 7-seg 1
      digitalWrite(2,HIGH); 
			digitalWrite(3,LOW); 
			digitalWrite(4,LOW); 
			digitalWrite(5,HIGH); 
			digitalWrite(6,HIGH); 
			digitalWrite(7,HIGH); 
			digitalWrite(8,HIGH);
      // OLED 1
      u8g.firstPage();
      do { u8g.drawBitmapP(0,0,16,64,OLED_1); } while(u8g.nextPage());
    }
    else if(count == 2) {
      // 7-seg 2
      digitalWrite(2,LOW); 
			digitalWrite(3,LOW); 
			digitalWrite(4,HIGH); 
			digitalWrite(5,LOW); 
			digitalWrite(6,LOW); 
			digitalWrite(7,HIGH); 
			digitalWrite(8,LOW);
      // OLED 2
      u8g.firstPage();
      do { u8g.drawBitmapP(0,0,16,64,OLED_Two); } while(u8g.nextPage());
    }
		else if(count == 3) {
      // 7-seg 3
      digitalWrite(2,LOW);
			digitalWrite(3,LOW);
			digitalWrite(4,LOW);
			digitalWrite(5,LOW);
			digitalWrite(6,HIGH);
			digitalWrite(7,HIGH);
			digitalWrite(8,LOW);
			//oled 3
      u8g.firstPage();
      do { u8g.drawBitmapP(0,0,16,64,OLED_3); } while(u8g.nextPage());
    }
		else if(count == 4) {
      // 7-seg 4
      digitalWrite(2,HIGH);
			digitalWrite(3,LOW);
			digitalWrite(4,LOW);
			digitalWrite(5,HIGH);
			digitalWrite(6,HIGH);
			digitalWrite(7,LOW);
			digitalWrite(8,LOW);
      // OLED 4
      u8g.firstPage();
      do { u8g.drawBitmapP(0,0,16,64,OLED_4); } while(u8g.nextPage());
    }
		else if(count == 5) {
      // 7-seg 5
     	digitalWrite(2,LOW);
			digitalWrite(3,HIGH);
			digitalWrite(4,LOW);
			digitalWrite(5,LOW);
			digitalWrite(6,HIGH);
			digitalWrite(7,LOW);
			digitalWrite(8,LOW);
      // OLED 5
      u8g.firstPage();
      do { u8g.drawBitmapP(0,0,16,64,OLED_5); } while(u8g.nextPage());
    }
		else if(count == 6) {
      // 7-seg 6
     	digitalWrite(2,LOW);
			digitalWrite(3,HIGH);
			digitalWrite(4,LOW);
			digitalWrite(5,LOW);
			digitalWrite(6,LOW);
			digitalWrite(7,LOW);
			digitalWrite(8,LOW);
			
      // OLED 6
      u8g.firstPage();
      do { u8g.drawBitmapP(0,0,16,64,OLED_6); } while(u8g.nextPage());
    }
		else if(count == 7) {
      // 7-seg 7
     	digitalWrite(2,LOW);
			digitalWrite(3,LOW);
			digitalWrite(4,LOW);
			digitalWrite(5,HIGH);
			digitalWrite(6,HIGH);
			digitalWrite(7,HIGH);
			digitalWrite(8,HIGH);
			
      // OLED 7
      u8g.firstPage();
      do { u8g.drawBitmapP(0,0,16,64,OLED_7); } while(u8g.nextPage());
    }
		else if(count == 8) {
      // 7-seg 8
     	digitalWrite(2,LOW);
			digitalWrite(3,LOW);
			digitalWrite(4,LOW);
			digitalWrite(5,LOW);
			digitalWrite(6,LOW);
			digitalWrite(7,LOW);
			digitalWrite(8,LOW);
			
			
      // OLED 8
      u8g.firstPage();
      do { u8g.drawBitmapP(0,0,16,64,OLED_8); } while(u8g.nextPage());
    }
		else if(count == 9) {
